{
  "name": "arvoo-mainpanel",
  "version": "0.1.0",
  "private": true,
  "description": "Arvoo VPN Infrastructure Control Plane",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:agent": "npm run dev -w apps/agent",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/agent && npm run build -w apps/web",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx apps/api/src/db/migrate-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "concurrently": "^9.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
