# security audit (spec §35)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# firewall (managed ufw)
# ---------------------------------------------------------------------------

# Admin session for firewall commands. Credentials come from the environment or
# an interactive prompt; they are never passed as arguments and never logged.
api_admin_token() {
  local user="${ARVOO_ADMIN_USER:-admin}" password="${ARVOO_ADMIN_PASSWORD:-}" token=""
  if [[ -z "$password" ]]; then
    [[ -t 0 ]] || return 1
    read -r -p "Arvoo admin username [$user]: " input_user
    if [[ -n "${input_user:-}" ]]; then user="$input_user"; fi
    read -r -s -p "Password for $user (not stored): " password; printf '\n'
  fi
  token="$(api_login_token "$user" "$password")"
  unset password
  [[ -n "$token" ]] || return 1
  printf '%s' "$token"
}

firewall_plan_json() {
  local host="$1" token="$2"
  curl -fsS --max-time 20 "$(api_base)/api/v1/firewall/plan?host=$(printf '%s' "$host" | sed 's/[^A-Za-z0-9._-]//g')" \
    -H "Authorization: Bearer $token" 2>/dev/null
}

firewall_apply_api() {
  local host="$1" action="$2" token="$3"
  curl -fsS --max-time 30 -X POST "$(api_base)/api/v1/firewall/apply" \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    --data-binary "$(printf '{"host":"%s","action":"%s"}' "$(json_escape "$host")" "$action")" 2>/dev/null
}

# Apply the plan that the control plane computed for THIS host, locally.
# Used when the systemd path unit is not installed, and by '--local'.
firewall_apply_local() {
  require_root "firewall apply --local"
  local token="$1"
  local helper="/opt/arvoo/apps/agent/dist/firewall-cli.js"
  [[ -f "$helper" ]] || die "$helper is missing; run ./install.sh --update first"
  local plan_json tmp
  plan_json="$(firewall_plan_json self "$token")"
  [[ -n "$plan_json" ]] || die "could not read the firewall plan from the control plane"
  tmp="$(mktemp /tmp/arvoo-firewall-plan.XXXXXX)"
  chmod 600 "$tmp"
  printf '%s' "$plan_json" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["plan"]))' > "$tmp" || die "could not parse the plan"
  if node "$helper" --plan "$tmp" --action "${ACTION:-enable}"; then
    ok "firewall applied locally on this host (action: ${ACTION:-enable})"
  else
    warn "the helper reported a problem; the output above is the real ufw result"
  fi
  rm -f "$tmp"
}

cmd_firewall() {
  require_linux
  local action="${1:-status}"
  local host="self" target_action="enable"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="${2:-self}"; shift 2 ;;
      --self) host="self"; shift ;;
      --local) LOCAL_ONLY=1; shift ;;
      *) die "usage: arvoo firewall status|plan|enable|update|disable [--host self|<node-id>] [--local]" ;;
    esac
  done

  local token; token="$(api_admin_token)" || die "an admin session is required (set ARVOO_ADMIN_USER/ARVOO_ADMIN_PASSWORD or answer the prompt)"

  case "$action" in
    status)
      local overview
      overview="$(curl -fsS --max-time 20 "$(api_base)/api/v1/firewall" -H "Authorization: Bearer $token" 2>/dev/null || true)"
      [[ -n "$overview" ]] || die "could not read the firewall overview"
      if [[ "$JSON" == "1" ]]; then printf '%s\n' "$overview"; return 0; fi
      hdr "Managed firewall (UFW)"
      printf '%s' "$overview" | python3 -c '
import json,sys
d = json.load(sys.stdin)
print("  spool dir: %s" % d["spoolDir"])
p = d["policy"]
print("  policy: ssh %s · panel %s · icmp %s · inactive inbounds %s" % (
    ",".join(str(x) for x in p["sshPorts"]), ",".join(str(x) for x in p["panelPorts"]),
    "allowed" if p["allowIcmp"] else "blocked", "included" if p["includeInactiveInbounds"] else "excluded"))
for h in d["hosts"]:
    last = h.get("lastApply") or {}
    print("  %-28s %-7s %-10s rules=%-3s ports=%-18s %s" % (
        h["name"][:28], "active" if h["enabled"] else "inactive",
        "in sync" if h["inSync"] else "out of date", h["rulesCount"],
        ",".join(str(x) for x in h["publicPorts"]) or "-",
        ("last %s/%s" % (last.get("action", "?"), last.get("status", "?"))) if last else "never applied"))
    for w in h.get("warnings", []):
        print("      ! %s" % w)
'
      ;;
    plan)
      local plan_json; plan_json="$(firewall_plan_json "$host" "$token")"
      [[ -n "$plan_json" ]] || die "could not read the firewall plan"
      if [[ "$JSON" == "1" ]]; then printf '%s\n' "$plan_json"; return 0; fi
      hdr "Firewall plan for $host"
      printf '%s' "$plan_json" | python3 -c '
import json,sys
d = json.load(sys.stdin)
print("  hash %s · %d rules · %d to add · %d to remove" % (d["plan"]["hash"], len(d["plan"]["rules"]), len(d["diff"]["added"]), len(d["diff"]["removed"])))
for w in d["plan"]["warnings"]:
    print("  ! %s" % w)
for c in d["commands"]:
    print("  ufw %s" % " ".join(c["argv"]))
'
      ;;
    enable|update|disable)
      target_action="$action"
      if [[ "${LOCAL_ONLY:-0}" == "1" ]]; then
        ACTION="$target_action" firewall_apply_local "$token"
        return 0
      fi
      confirm "$action the firewall on host '$host' (current rules Arvoo manages are updated, foreign rules are untouched)" || exit "$EXIT_OK"
      local response; response="$(firewall_apply_api "$host" "$target_action" "$token")" || die "firewall request failed"
      [[ -n "$response" ]] || die "empty response from the control plane"
      if [[ "$JSON" == "1" ]]; then printf '%s\n' "$response"; return 0; fi
      printf '%s' "$response" | python3 -c '
import json,sys
d = json.load(sys.stdin)
status = d["status"]
print("  %s: %s rules added, %s removed — %s" % (status, len(d["added"]), len(d["removed"]), d["detail"]))
sys.exit(0 if status in ("queued", "success") else 1)
' || die "the firewall change was not accepted"
      say "  verify with: arvoo firewall status"
      ;;
    *) die "usage: arvoo firewall status|plan|enable|update|disable [--host self|<node-id>] [--local]" ;;
  esac
  unset token
}

cmd_security_audit() {
  require_linux
  hdr "Local checks"
  local problems=0

  if [[ -e "$ENV_FILE" ]]; then
    local mode owner
    mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null)"
    owner="$(stat -c '%U' "$ENV_FILE" 2>/dev/null)"
    if [[ "$mode" == "640" || "$mode" == "600" || "$mode" == "440" ]]; then ok "$ENV_FILE mode $mode owned by $owner"
    else fail "$ENV_FILE mode is $mode; expected 640 or stricter"; problems=$((problems+1)); fi
  elif on_node; then
    # A node has no panel env file; the file that matters here is the agent's.
    if [[ -e "$AGENT_ENV_FILE" ]]; then
      local amode
      amode="$(stat -c '%a' "$AGENT_ENV_FILE" 2>/dev/null)"
      if [[ "$amode" == "640" || "$amode" == "600" ]]; then ok "$AGENT_ENV_FILE mode $amode"
      else fail "$AGENT_ENV_FILE mode is $amode; expected 640 or stricter"; problems=$((problems+1)); fi
    else
      warn "$AGENT_ENV_FILE not present (agent not installed yet)"
    fi
  else
    warn "$ENV_FILE not present (nothing to protect, or not installed yet)"
  fi

  if [[ -e "$MANAGEMENT_SECRET_FILE" ]]; then
    local mmode; mmode="$(stat -c '%a' "$MANAGEMENT_SECRET_FILE" 2>/dev/null)"
    if [[ "$mmode" == "600" ]]; then ok "management secret recovery file mode 600 (root only)"
    else fail "$MANAGEMENT_SECRET_FILE mode is $mmode; expected 600"; problems=$((problems+1)); fi
  fi

  if [[ -e "$AGENT_STATE_FILE" ]]; then
    local mode; mode="$(stat -c '%a' "$AGENT_STATE_FILE" 2>/dev/null)"
    if [[ "$mode" == "600" || "$mode" == "640" ]]; then ok "node identity file mode $mode"
    else fail "node identity file mode is $mode; expected 600"; problems=$((problems+1)); fi
  fi

  if have ss; then
    local exposed
    exposed="$(ss -H -lnt 2>/dev/null | awk -v p=":$(api_port)" '$4 ~ p && $4 !~ /127\.0\.0\.1|\[::1\]/ {print $4}')"
    if [[ -n "$exposed" ]]; then fail "panel API listens on a public interface: $exposed"; problems=$((problems+1));
    else ok "panel API is loopback-only"; fi
  fi

  if [[ -d "$INSTALL_ROOT/apps/web/dist" ]]; then
    if find "$INSTALL_ROOT/apps/web/dist" -name '*.map' -print -quit 2>/dev/null | grep -q .; then
      fail "production build ships source maps"; problems=$((problems+1))
    else ok "no source maps in the panel build"; fi
  fi

  if have nginx && unit_exists nginx; then
    if nginx -T 2>/dev/null | grep -q 'X-Robots-Tag'; then ok "X-Robots-Tag present in the served configuration"
    else warn "X-Robots-Tag not found in nginx configuration"; fi
  fi

  if [[ -r /etc/ssh/sshd_config ]]; then
    if grep -qiE '^\s*PasswordAuthentication\s+yes' /etc/ssh/sshd_config; then warn "SSH password authentication is enabled"; else ok "SSH password authentication disabled"; fi
  fi

  if on_node; then
    [[ "$JSON" == "1" ]] || say ""
    if (( problems > 0 )); then fail "$problems local check(s) need attention"; exit "$EXIT_FAIL"; fi
    ok "no local security problems found (control-plane posture is checked on the panel host)"
    return 0
  fi

  if [[ "$JSON" != "1" ]]; then
    hdr "Control plane posture"
    say "${C_DIM}(needs admin credentials; never stored)${C_RESET}"
  fi
  if [[ -t 0 && "$JSON" != "1" ]]; then
    local user="admin" password="" token response
    read -r -p "Admin username [$user] (blank to skip the API checks): " input_user
    if [[ -n "${input_user:-}" ]]; then
      user="$input_user"
      read -r -s -p "Password for $user: " password; printf '\n'
    fi
    if [[ -n "$password" ]]; then
      token="$(api_login_token "$user" "$password")"; unset password
      if [[ -n "$token" ]]; then
        response="$(curl -fsS --max-time 10 "$(api_base)/api/v1/system/security" -H "Authorization: Bearer $token" 2>/dev/null || true)"
        if [[ -n "$response" ]]; then
          if [[ "$JSON" == "1" ]]; then printf '%s\n' "$response"; else say "$response" | sed 's/[{}]//g; s/","/\n        /g; s/"//g' | sed 's/^/        /'; fi
        else
          warn "API security endpoint returned nothing"
        fi
      else
        warn "could not authenticate; API posture checks skipped"
      fi
    fi
  fi

  [[ "$JSON" == "1" ]] || say ""
  if (( problems > 0 )); then fail "$problems local check(s) need attention"; exit "$EXIT_FAIL"; fi
  ok "no local security problems found"
}

# ---------------------------------------------------------------------------
# configuration summary / version
# ---------------------------------------------------------------------------

cmd_config() {
  require_linux
  local mode; mode="$(host_role)"
  local db_masked="-"
  local url; url="$(env_file_value DATABASE_URL || true)"
  if [[ -n "$url" ]]; then
    db_masked="$(printf '%s' "$url" | sed 's#://\([^:]*\):[^@]*@#://\1:***@#')"
  fi
  if [[ "$JSON" == "1" ]]; then
    printf '{"mode":"%s","installRoot":"%s","envFile":"%s","apiBase":"%s","backupDir":"%s","database":"%s","units":[' \
      "$mode" "$(json_escape "$INSTALL_ROOT")" "$(json_escape "$ENV_FILE")" "$(json_escape "$(api_base)")" "$(json_escape "$BACKUP_DIR")" "$(json_escape "$db_masked")"
    local first=1 unit state
    while IFS=$'\t' read -r unit state; do
      [[ "$first" == "1" ]] || printf ','
      first=0
      printf '{"unit":"%s","state":"%s"}' "$(json_escape "$unit")" "$(json_escape "$state")"
    done < <(service_rows)
    printf ']}\n'
    return 0
  fi
  hdr "Configuration summary"
  say "        role:        $mode"
  say "        install root: $INSTALL_ROOT"
  say "        env file:    $ENV_FILE"
  say "        api:         $(api_base)"
  say "        database:    $db_masked"
  say "        backups:     $BACKUP_DIR"
  say "        version:     $(cli_version)"
  while IFS=$'\t' read -r unit state; do say "        $unit: $state"; done < <(service_rows)
}

cmd_version() {
  if [[ "$JSON" == "1" ]]; then printf '{"name":"arvoo","version":"%s","platform":"%s"}\n' "$(json_escape "$(cli_version)")" "$(json_escape "$(uname -s)")"
  else printf 'arvoo %s (%s)\n' "$(cli_version)" "$(uname -s)"; fi
}

usage() {
  cat <<'USAGE'
Arvoo Management CLI

Usage: sudo arvoo [command] [options]

Commands:
  status                 services, health and row counts
  health                 API and database health (exit code reflects reality)
  start | stop | restart | reload
                         service management; reload prefers graceful reloads
  diagnostics            real system checks with actionable results
  logs [--component C] [--follow]
                         journald logs (C: master, node, nginx, postgresql)
  node status            this host's role, enrollment and agent state
  tunnel status          GRE interfaces, routes and desired state
  secret rotate          rotate the session signing secret (invalidates sessions)
  management status | enable | rotate | disable
                         second-layer management access secret
  firewall status | plan | enable | update | disable [--host self|<node>]
                         managed UFW: SSH + panel + every deployed inbound and
                         tunnel port of a host, applied and verified with ufw
                         (--local applies this host's plan directly instead of
                         going through the privileged helper)
  cert status | cert renew
                         ACME certificate lifecycle
  repair                 idempotent repair through install.sh
  update                 pull, rebuild, migrate, restart (backup first)
  backup | restore --file <dump>
                         PostgreSQL backup and verified restore
  security-audit         local hardening checks plus control plane posture
  config                 configuration summary (secrets masked)
  version                version information
  help                   this help

Options:
  --json        machine-readable output where supported
  --yes         skip confirmations (automation; never for read-only commands)
  --quiet       only warnings and errors
  -h, --help    this help

Notes:
  * Read-only commands do not need root; changes do.
  * Secrets are never printed, never passed as arguments and never logged.
  * Running `arvoo` with no arguments shows an interactive menu.
USAGE
}

# ---------------------------------------------------------------------------
# interactive menu (only implemented commands are listed)
# ---------------------------------------------------------------------------

menu() {
  require_linux
  local choice
  while true; do
    cat <<'MENU'

Arvoo Management CLI
 1. Status                    12. Tunnel status
 2. Health check              13. Rotate session secret
 3. Start services            14. Certificate status
 4. Stop services             15. Renew certificate
 5. Restart services          16. Repair installation
 6. Reload configuration      17. Update
 7. Service logs              18. Backup
 8. Diagnostics               19. Restore
 9. Node status               20. Security audit
10. Configuration summary     21. Version
11. Exit                      22. Management secret
23. Firewall status            24. Config & Enable UFW
25. Update UFW                26. Firewall plan
27. Disable UFW
MENU
    printf 'Select: '
    read -r choice || exit "$EXIT_OK"
    case "${choice//[[:space:]]/}" in
      1) cmd_status ;;
      2) cmd_health ;;
      3) cmd_start ;;
      4) cmd_stop ;;
      5) cmd_restart ;;
      6) cmd_reload ;;
      7) cmd_logs ;;
      8) cmd_diagnostics ;;
      9) cmd_node_status ;;
      10) cmd_config ;;
      11) exit "$EXIT_OK" ;;
      12) cmd_tunnel_status ;;
      13) cmd_secret_rotate ;;
      14) cmd_cert_status ;;
      15) cmd_cert_renew ;;
      16) cmd_repair ;;
      17) cmd_update ;;
      18) cmd_backup ;;
      19) printf 'Backup file path: '; read -r RESTORE_FILE; cmd_restore ;;
      20) cmd_security_audit ;;
      21) cmd_version ;;
      22) cmd_management status ;;
      23) cmd_firewall status ;;
      24) cmd_firewall enable ;;
      25) cmd_firewall update ;;
      26) cmd_firewall plan ;;
      27) cmd_firewall disable ;;
      *) printf 'Unknown choice: %s\n' "$choice" >&2 ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# argument parsing
# ---------------------------------------------------------------------------

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --quiet) QUIET=1; shift ;;
    --yes) ASSUME_YES=1; shift ;;
    --follow|-f) FOLLOW=1; shift ;;
    --component) COMPONENT="${2:-}"; shift 2 ;;
    --file) RESTORE_FILE="${2:-}"; shift 2 ;;
    -h|--help) SHOW_HELP=1; shift ;;
    --version|-V) SHOW_VERSION=1; shift ;;
    -*) printf 'arvoo: unknown option %s (see arvoo --help)\n' "$1" >&2; exit 64 ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ "$SHOW_HELP" == "1" ]]; then usage; exit "$EXIT_OK"; fi
if [[ "$SHOW_VERSION" == "1" ]]; then cmd_version; exit "$EXIT_OK"; fi

command="${args[0]:-}"
sub="${args[1]:-}"

case "$command" in
  "")          menu ;;
  status)      cmd_status ;;
  health)      cmd_health ;;
  start)       cmd_start ;;
  stop)        cmd_stop ;;
  restart)     cmd_restart ;;
  reload)      cmd_reload ;;
  diagnostics) cmd_diagnostics ;;
  logs)        cmd_logs ;;
  node)        [[ "$sub" == "status" ]] || die "usage: arvoo node status"; cmd_node_status ;;
  tunnel)      [[ "$sub" == "status" ]] || die "usage: arvoo tunnel status"; cmd_tunnel_status ;;
  secret)      [[ "$sub" == "rotate" ]] || die "usage: arvoo secret rotate"; cmd_secret_rotate ;;
  management)  cmd_management "${args[1]:-status}" ;;
  firewall)    cmd_firewall "${args[1]:-status}" "${args[@]:2}" ;;
  cert)        case "$sub" in status) cmd_cert_status ;; renew) cmd_cert_renew ;; *) die "usage: arvoo cert status|renew" ;; esac ;;
  repair)      cmd_repair ;;
  update)      cmd_update ;;
  backup)      cmd_backup ;;
  restore)     cmd_restore ;;
  security-audit) cmd_security_audit ;;
  config)      cmd_config ;;
  version)     cmd_version ;;
  help)        usage ;;
  *)           printf 'arvoo: unknown command %s (see arvoo --help)\n' "$command" >&2; exit 64 ;;
esac
