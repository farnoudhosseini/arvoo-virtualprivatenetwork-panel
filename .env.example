# Arvoo Control Plane - environment configuration
#
# Copy to .env and fill in real values. Production installs usually do NOT use
# this file: the systemd service loads /etc/arvoo.env instead (see DEPLOYMENT.md).
# Never commit a real .env; .env is gitignored.
#
# Secrets below are placeholders ONLY - generate your own with:
#   openssl rand -hex 32
#
# The installer keeps these in /etc/arvoo.env (mode 0640 root:arvoo) and reuses
# existing values on every re-run, so secrets are never regenerated by accident.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production                      # production | development (fails fast on missing secrets when production)
HOST=127.0.0.1                          # bind address; Nginx proxies public traffic, so 127.0.0.1 only
PORT=4001                               # backend port, NOT exposed publicly
LOG_LEVEL=info                          # error | warn | info | debug

# CORS origins allowed to call the API (comma separated). Behind Nginx
# same-origin this is the public URL of the panel.
ARVOO_CORS_ORIGINS=https://panel.example.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL) - REQUIRED
# ---------------------------------------------------------------------------
# Connection string consumed by node-postgres. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://arvoo_user:CHANGE_ME@127.0.0.1:5432/arvoo

# Connection pool size (node-postgres Pool).
ARVOO_POOL_MAX=10

# Optional: override where migrations are read from (defaults to
# apps/api/src/migrations in the repo layout).
# ARVOO_MIGRATIONS_DIR=/opt/arvoo/apps/api/src/migrations

# ---------------------------------------------------------------------------
# Secrets - REQUIRED in production
# ---------------------------------------------------------------------------
# Master secret. Used as the AES-256-GCM key that encrypts stored secrets at
# rest (inbound TLS keys, client private keys) AND as the session/JWT signing
# key. If lost, previously issued certificate material must be re-issued and
# every active session is invalidated. 32+ hex/ascii chars:
#   openssl rand -hex 32
ARVOO_APP_SECRET=

# Admin bootstrap credentials. Used ONLY to create the first admin account;
# ignored once an admin exists. Change the password after first login.
ARVOO_ADMIN_USER=admin
ARVOO_ADMIN_PASSWORD=arvoo-admin

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Session/JWT lifetime in seconds (default 12h).
# ARVOO_JWT_TTL_SEC=43200

# Seconds without a node heartbeat before the node is marked offline.
# ARVOO_HEARTBEAT_OFFLINE_SEC=90

# Health-sample retention in days (used by the retention sweep).
# ARVOO_HEALTH_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Operations (read by install.sh and scripts/backup.sh, not by the API)
# ---------------------------------------------------------------------------
# Number of pg_dump backups kept in ARVOO_BACKUP_DIR (default /var/backups/arvoo).
# ARVOO_BACKUP_KEEP=14

# ---------------------------------------------------------------------------
# Agent (runs on managed nodes, points at this control plane)
# ---------------------------------------------------------------------------
# Where agents reach the API. On a real deployment this is the public URL.
ARVOO_CONTROL_PLANE_URL=https://panel.example.com
